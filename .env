# Foundry Local endpoint - "foundry service status" komutuyla öğrenilebilir.
FOUNDRY_ENDPOINT=http://127.0.0.1:61432/v1
FOUNDRY_MODEL=phi-3.5-mini-instruct-trtrtx-gpu:2

# Embedding modeli (sentence-transformers, tamamen yerel)
EMBEDDING_MODEL=all-MiniLM-L6-v2

# ChromaDB ve PDF klasörleri
CHROMA_PATH=./chroma_db
DATA_PATH=./data
